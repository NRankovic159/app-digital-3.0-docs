+      {%- capture options_json -%}
+        {%- for index in (-5..25) -%}
+          {%- if index < 1 -%}
+            {%- assign i = index | plus: 6 -%}
+            {%- assign is_base_option = true -%}
+          {%- else -%}
+            {%- assign i = index -%}
+            {%- assign is_base_option = false -%}
+          {%- endif -%}
+
+          {%- assign meta_lable = 'apl_Option' | append: i | append: 'Label' -%}
+          {%- assign prod_meta_value = 'apl_Option' | append: i | append: 'Value' -%}
+
+          {%- if is_base_option -%}
+            {%- assign meta_lable = 'apl_app_BaseOption' | append: i | append: 'Label' -%}
+            {%- assign prod_meta_value = 'apl_app_BaseOption' | append: i | append: 'Value' -%}
+          {%- endif -%}
+
+          {%- if is_base_option -%}
+          {%- elsif collection.metafields.apple[meta_lable].value != blank -%}
+            {%- if product.metafields.apple[prod_meta_value].value == blank -%}
+              {%- assign prod_meta_value = 'apl_cto_Option' | append: i | append: 'Value' -%}
+            {%- endif -%}
+          {%- else -%}
+            {%- assign meta_lable = 'apl_cto_Option' | append: i | append: 'Label' -%}
+            {%- assign prod_meta_value = 'apl_cto_Option' | append: i | append: 'Value' -%}
+          {%- endif -%}
+
+          {%- assign opt_value = product.metafields.apple[prod_meta_value].value -%}
+          {%- if opt_value != blank -%}
+            {%- assign opt_value_str = opt_value | strip -%}
+            {%- assign opt_label_str = collection.metafields.apple[meta_lable].value | strip -%}
+            {%- if options_pipe == '' -%}
+              {%- assign options_pipe = opt_value_str -%}
+              {%- assign options_pipe_with_label = opt_value_str | append: opt_label_str -%}
+            {%- else -%}
+              {%- assign options_pipe = options_pipe | append: '|!' | append: opt_value_str -%}
+              {%- assign options_pipe_with_label = options_pipe_with_label | append: '|!' | append: opt_value_str | append: opt_label_str -%}
+            {%- endif -%}
+            {%- unless options_first -%},{%- endunless -%}
+            {%- assign options_first = false -%}
+            {{- opt_label_str | json -}}:{{- opt_value_str | json -}}
+          {%- endif -%}
+        {%- endfor -%}
+      {%- endcapture -%}

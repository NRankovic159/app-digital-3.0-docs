diff --git a/theme/snippets/breadcrumbs.liquid b/theme/snippets/breadcrumbs.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..08cc891cc56544a85703f93f17c023e77cfde1fc
--- /dev/null
+++ b/theme/snippets/breadcrumbs.liquid
@@ -0,0 +1,496 @@
+{%- comment -%}
+  Renders breadcrumbs navigation for the current page.
+
+  Does not render on the homepage (template.name == 'index') or when
+  breadcrumbs_enable is false in section settings.
+
+  Supported page types:
+  - Collection pages  — [APP ›] [Page Map ›] Collection
+  - Product pages     — [APP ›] [Page Map ›] [Collection ›] Buy Product
+  - Standard pages    — [APP ›] [Parent ›] Page title
+  - Blog pages        — [APP ›] Blog title
+  - Article pages     — [APP ›] Blog title › Article title
+  - Search page       — [APP ›] Search results
+  - 404 page          — [APP ›] Page not found
+
+  Items in [ ] are optional depending on settings and context.
+
+  Accepts:
+  - section:  {Object} Required. The calling section object, used for
+             breadcrumbs_enable, breadcrumbs_home_title,
+             breadcrumbs_search_title, breadcrumbs_page_mapping,
+             breadcrumbs_page_navigation, and
+             breadcrumbs_excluded_collections settings.
+  - context: {String} Optional. Controls responsive visibility.
+             'mobile'  — visible only below 768 px.
+             'desktop' — visible only at 768 px and above.
+             Omit to show at all screen sizes.
+             When rendering in both contexts, the JSON-LD structured data
+             block is only output for the non-mobile context to avoid
+             duplicate markup.
+
+  Usage:
+  {%- render 'breadcrumbs', section: section -%}
+  {%- render 'breadcrumbs', section: section, context: 'mobile' -%}
+  {%- render 'breadcrumbs', section: section, context: 'desktop' -%}
+{%- endcomment -%}
+
+{%- if template.name != 'index' and section.settings.breadcrumbs_enable -%}
+  {%- liquid
+    assign bc_home   = section.settings.breadcrumbs_home_title
+    assign bc_search = section.settings.breadcrumbs_search_title
+    assign bc_json   = ''
+    assign bc_pos    = 0
+    assign bc_page_link_url   = nil
+    assign bc_page_link_title = nil
+
+    assign bc_excluded_handles = ''
+    for excl in section.settings.breadcrumbs_excluded_collections
+      assign bc_excluded_handles = bc_excluded_handles | append: excl.handle | append: '|'
+    endfor
+  -%}
+
+  {%- comment -%} Reusable separator markup {%- endcomment -%}
+  {%- capture bc_sep -%}
+    <span class="breadcrumbs__separator" aria-hidden="true">
+      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
+        <path fill-rule="evenodd" clip-rule="evenodd" d="M5.99998 2.83834L5.16162 3.67669L9.48491 7.99998L5.16162 12.3233L5.99998 13.1616L11.1616 7.99998L5.99998 2.83834Z" fill="#1D1D1F"/>
+      </svg>
+    </span>
+  {%- endcapture -%}
+
+  {%- comment -%} Build JSON-LD items — all entries use a leading comma; the first comma is stripped at output {%- endcomment -%}
+
+  {%- if bc_home != blank -%}
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_home | json }},"item":"{{ shop.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+  {%- endif -%}
+
+  {%- if template.name == 'collection' -%}
+    {%- liquid
+      assign bc_product_type_h = collection.products.first.type | handleize
+
+      if bc_product_type_h != blank and section.settings.breadcrumbs_page_mapping != blank
+        for link in linklists[section.settings.breadcrumbs_page_mapping].links
+          assign bc_link_match  = false
+          assign bc_link_title_h = link.title | handleize
+          if bc_link_title_h contains bc_product_type_h or bc_product_type_h contains bc_link_title_h
+            assign bc_link_match = true
+          endif
+          if bc_link_match == false and link.type == 'page_link'
+            assign bc_page_suffix_h = link.object.template_suffix | handleize
+            assign bc_page_title_h  = link.object.title | handleize
+            if bc_page_suffix_h contains bc_product_type_h
+              assign bc_link_match = true
+            endif
+            if bc_link_match == false and bc_page_suffix_h != blank and bc_product_type_h contains bc_page_suffix_h
+              assign bc_link_match = true
+            endif
+            if bc_link_match == false and bc_page_title_h contains bc_product_type_h
+              assign bc_link_match = true
+            endif
+            if bc_link_match == false and bc_product_type_h contains bc_page_title_h
+              assign bc_link_match = true
+            endif
+          endif
+          if bc_link_match
+            assign bc_page_link_url   = link.url
+            assign bc_page_link_title = link.object.title | default: link.title
+            break
+          endif
+        endfor
+      endif
+    -%}
+
+    {%- if bc_page_link_url -%}
+      {%- assign bc_pos = bc_pos | plus: 1 -%}
+      {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_page_link_title | json }},"item":"{{ shop.url }}{{ bc_page_link_url }}"}{%- endcapture -%}
+      {%- assign bc_json = bc_json | append: bc_tmp -%}
+    {%- endif -%}
+
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ collection.title | json }},"item":"{{ shop.url }}{{ collection.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- elsif template.name == 'product' -%}
+    {%- liquid
+      assign bc_collection = nil
+
+      if collection
+        unless collection.handle contains 'apl-ps-' or collection.handle contains 'apl_ps'
+          assign bc_handle_excl = collection.handle | append: '|'
+          unless bc_excluded_handles contains bc_handle_excl
+            assign bc_collection = collection
+          endunless
+        endunless
+      endif
+
+      if bc_collection == nil
+        for col in product.collections
+          unless col.handle contains 'apl-ps-' or col.handle contains 'apl_ps'
+            assign bc_handle_excl = col.handle | append: '|'
+            unless bc_excluded_handles contains bc_handle_excl
+              if col.template_suffix contains 'plp'
+                assign bc_collection = col
+                break
+              endif
+            endunless
+          endunless
+        endfor
+      endif
+
+      if bc_collection == nil
+        assign bc_base_coll_handle = product.metafields.apple.apl_BaseProductCollectionHandle.value.handle
+        if bc_base_coll_handle == blank
+          assign bc_base_coll_handle = product.metafields.apple.apl_BaseProductCollection.value
+        endif
+        if bc_base_coll_handle != blank
+          assign bc_base_coll = collections[bc_base_coll_handle]
+          for base_product in bc_base_coll.products
+            for col in base_product.collections
+              unless col.handle contains 'apl-ps-' or col.handle contains 'apl_ps'
+                assign bc_handle_excl = col.handle | append: '|'
+                unless bc_excluded_handles contains bc_handle_excl
+                  if col.template_suffix contains 'plp'
+                    assign bc_collection = col
+                    break
+                  endif
+                endunless
+              endunless
+            endfor
+            if bc_collection != nil
+              break
+            endif
+          endfor
+        endif
+      endif
+
+      if bc_collection == nil
+        for col in product.collections
+          unless col.handle contains 'apl-ps-' or col.handle contains 'apl_ps'
+            assign bc_handle_excl = col.handle | append: '|'
+            unless bc_excluded_handles contains bc_handle_excl
+              assign bc_collection = col
+              break
+            endunless
+          endunless
+        endfor
+      endif
+
+      assign bc_product_type_h = product.type | handleize
+
+      if bc_product_type_h != blank and section.settings.breadcrumbs_page_mapping != blank
+        for link in linklists[section.settings.breadcrumbs_page_mapping].links
+          assign bc_link_match   = false
+          assign bc_link_title_h = link.title | handleize
+          if bc_link_title_h contains bc_product_type_h or bc_product_type_h contains bc_link_title_h
+            assign bc_link_match = true
+          endif
+          if bc_link_match == false and link.type == 'page_link'
+            assign bc_page_suffix_h = link.object.template_suffix | handleize
+            assign bc_page_title_h  = link.object.title | handleize
+            if bc_page_suffix_h contains bc_product_type_h
+              assign bc_link_match = true
+            endif
+            if bc_link_match == false and bc_page_suffix_h != blank and bc_product_type_h contains bc_page_suffix_h
+              assign bc_link_match = true
+            endif
+            if bc_link_match == false and bc_page_title_h contains bc_product_type_h
+              assign bc_link_match = true
+            endif
+            if bc_link_match == false and bc_product_type_h contains bc_page_title_h
+              assign bc_link_match = true
+            endif
+          endif
+          if bc_link_match
+            assign bc_page_link_url   = link.url
+            assign bc_page_link_title = link.object.title | default: link.title
+            break
+          endif
+        endfor
+      endif
+    -%}
+
+    {%- if bc_page_link_url -%}
+      {%- assign bc_pos = bc_pos | plus: 1 -%}
+      {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_page_link_title | json }},"item":"{{ shop.url }}{{ bc_page_link_url }}"}{%- endcapture -%}
+      {%- assign bc_json = bc_json | append: bc_tmp -%}
+    {%- endif -%}
+
+    {%- if bc_collection -%}
+      {%- assign bc_pos = bc_pos | plus: 1 -%}
+      {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_collection.title | json }},"item":"{{ shop.url }}{{ bc_collection.url }}"}{%- endcapture -%}
+      {%- assign bc_json = bc_json | append: bc_tmp -%}
+    {%- endif -%}
+
+    {%- liquid
+      assign bc_product_display_title = product.metafields.apple.apl_PrimaryDisplayTitle.value | default: product.title
+      assign bc_product_current_title = 'breadcrumbs.buy_prefix' | t | append: ' ' | append: bc_product_display_title
+    -%}
+
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_product_current_title | json }},"item":"{{ shop.url }}{{ product.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- elsif template.name == 'page' -%}
+    {%- liquid
+      assign bc_page_parent_url   = nil
+      assign bc_page_parent_title = nil
+
+      if section.settings.breadcrumbs_page_navigation != blank
+        for parent_link in linklists[section.settings.breadcrumbs_page_navigation].links
+          for child_link in parent_link.links
+            assign bc_child_match = false
+            if child_link.type == 'page_link' and child_link.object.id == page.id
+              assign bc_child_match = true
+            elsif child_link.url == page.url
+              assign bc_child_match = true
+            endif
+            if bc_child_match
+              assign bc_page_parent_url   = parent_link.url
+              assign bc_page_parent_title = parent_link.title
+              break
+            endif
+          endfor
+          if bc_page_parent_url
+            break
+          endif
+        endfor
+      endif
+    -%}
+
+    {%- if bc_page_parent_url -%}
+      {%- assign bc_pos = bc_pos | plus: 1 -%}
+      {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_page_parent_title | json }},"item":"{{ shop.url }}{{ bc_page_parent_url }}"}{%- endcapture -%}
+      {%- assign bc_json = bc_json | append: bc_tmp -%}
+    {%- endif -%}
+
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ page.title | json }},"item":"{{ shop.url }}{{ page.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- elsif template.name == 'blog' -%}
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- elsif template.name == 'article' -%}
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ article.title | json }},"item":"{{ shop.url }}{{ article.url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- elsif template.name == 'search' -%}
+    {%- if bc_search != blank -%}
+      {%- assign bc_pos = bc_pos | plus: 1 -%}
+      {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ bc_search | json }},"item":"{{ shop.url }}{{ routes.search_url }}"}{%- endcapture -%}
+      {%- assign bc_json = bc_json | append: bc_tmp -%}
+    {%- endif -%}
+
+  {%- elsif template.name == 'cart' -%}
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ 'templates.cart.cart' | t | json }},"item":"{{ shop.url }}{{ routes.cart_url }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- elsif template.name == '404' -%}
+    {%- assign bc_pos = bc_pos | plus: 1 -%}
+    {%- capture bc_tmp -%},{"@type":"ListItem","position":{{ bc_pos }},"name":{{ 'templates.404.title' | t | json }},"item":"{{ shop.url }}{{ request.path }}"}{%- endcapture -%}
+    {%- assign bc_json = bc_json | append: bc_tmp -%}
+
+  {%- endif -%}
+
+  {%- style -%}
+    .breadcrumbs {
+      padding: 0 16px;
+    }
+
+    .breadcrumbs__list {
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      scrollbar-width: none;
+      display: flex;
+      flex-wrap: nowrap;
+      align-items: center;
+      list-style: none;
+      margin: 0;
+      padding: 0 0 32px;
+      gap: 3px;
+    }
+
+    .breadcrumbs__list::-webkit-scrollbar {
+      display: none;
+    }
+
+    .breadcrumbs__item {
+      display: flex;
+      align-items: center;
+      white-space: nowrap;
+      flex-shrink: 0;
+      gap: 3px;
+    }
+
+    .breadcrumbs__separator {
+      display: inline-flex;
+      align-items: center;
+      flex-shrink: 0;
+    }
+
+    .breadcrumbs__item a,
+    .breadcrumbs__item .breadcrumbs__current {
+      font-family: "SF Pro Text", sans-serif;
+      font-size: 12px;
+      font-weight: 600;
+      line-height: 16px;
+      text-decoration: none;
+      color: #0071E3;
+    }
+
+    @media (hover: hover) {
+      .breadcrumbs__item a:hover {
+        text-decoration: underline;
+      }
+    }
+
+    .breadcrumbs--mobile {
+      display: block;
+      padding-top: 16px;
+    }
+
+    .breadcrumbs--desktop {
+      display: none;
+    }
+
+    @media screen and (min-width: 769px) {
+      .breadcrumbs {
+        padding: 0;
+      }
+
+      .breadcrumbs__list {
+        padding: 0 0 64px;
+      }
+
+      .breadcrumbs--mobile {
+        display: none;
+      }
+
+      .breadcrumbs--desktop {
+        display: block;
+      }
+    }
+  {%- endstyle -%}
+
+  {%- comment -%} Output JSON-LD once — skip for mobile render to avoid duplication {%- endcomment -%}
+  {%- unless context == 'mobile' -%}
+    <script type="application/ld+json">
+    {
+      "@context": "https://schema.org",
+      "@type": "BreadcrumbList",
+      "itemListElement": [{{ bc_json | remove_first: ',' }}]
+    }
+    </script>
+  {%- endunless -%}
+
+  {%- comment -%} Nav wrapper class {%- endcomment -%}
+  {%- liquid
+    if context == 'mobile'
+      assign bc_nav_class = 'breadcrumbs breadcrumbs--mobile'
+    elsif context == 'desktop'
+      assign bc_nav_class = 'breadcrumbs breadcrumbs--desktop'
+    else
+      assign bc_nav_class = 'breadcrumbs'
+    endif
+  -%}
+
+  <nav class="{{ bc_nav_class }}" aria-label="{{ 'breadcrumbs.aria_label' | t }}">
+    <ol class="breadcrumbs__list">
+      {%- if bc_home != blank -%}
+        {%- liquid
+          assign bc_show_home_sep = true
+          if template.name == 'search' and bc_search == blank
+            assign bc_show_home_sep = false
+          endif
+        -%}
+        <li class="breadcrumbs__item">
+          <a href="{{ routes.root_url }}">{{ bc_home }}</a>
+          {%- if bc_show_home_sep -%}{{ bc_sep }}{%- endif -%}
+        </li>
+      {%- endif -%}
+
+      {%- if template.name == 'collection' -%}
+        {%- if bc_page_link_url -%}
+          <li class="breadcrumbs__item">
+            <a href="{{ bc_page_link_url }}">{{ bc_page_link_title }}</a>
+            {{ bc_sep }}
+          </li>
+        {%- endif -%}
+        <li class="breadcrumbs__item">
+          <span class="breadcrumbs__current" aria-current="page">{{ collection.title }}</span>
+        </li>
+
+      {%- elsif template.name == 'product' -%}
+        {%- if bc_page_link_url -%}
+          <li class="breadcrumbs__item">
+            <a href="{{ bc_page_link_url }}">{{ bc_page_link_title }}</a>
+            {{ bc_sep }}
+          </li>

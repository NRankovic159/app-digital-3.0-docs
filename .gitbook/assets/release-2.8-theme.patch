diff --git a/theme/snippets/product-theft-and-loss-addon.liquid b/theme/snippets/product-theft-and-loss-addon.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..2316299d39ea2783acf5893603d18d931709dbd2
--- /dev/null
+++ b/theme/snippets/product-theft-and-loss-addon.liquid
@@ -0,0 +1,130 @@
+{% comment %}
+  Product AppleCare Theft and Loss Add-on
+
+  Renders the AppleCare Theft and Loss add-on card on the PDP. Shows the product image,
+  title, description, price, optional learn-more modal, and the
+  checkbox/add button used to attach AppleCare to the cart form.
+  Conditionally rendered only when productBaseCollection and a valid
+  AppleCare variant exist.
+
+  Params:
+  - productBaseCollection {String} Handle of the base product collection
+  - theftLossProduct {Object} The AppleCare Theft and Loss Liquid product object
+  - theftLossMetaobject {Object} AppleCare Theft and Loss Component metaobject (apl_TheftLoss_Component_LearnMoreModal)
+  - section {Object} The calling section object (provides section.settings.enable_learn_more)
+
+  Usage:
+  - In your liquid template file, copy the following lines:
+  {%- render 'product-applecare-addon',
+    productBaseCollection: productBaseCollection,
+    theftLossProduct: theftLossProduct,
+    theftLossMetaobject: theftLossMetaobject,
+    section: section
+  -%}
+{% endcomment %}
+
+<div class="theftloss-replace apl-section-main-product-theftloss">
+  {% if productBaseCollection and theftLossMetaobject != blank %}
+    {% assign this_variant_tl = theftLossProduct.selected_or_first_available_variant %}
+
+    {% if this_variant_tl.id != blank %}
+      {%- capture tl_modal_section_id -%}pdp-theftloss-modal-{{ section.id }}{%- endcapture -%}
+      {%- assign tl_acceptance_metaobject = theftLossMetaobject.pdp_component_active_acceptance.value -%}
+      {%- capture tl_acceptance_modal_section_id -%}pdp-theftloss-acceptance-modal-{{ section.id }}{%- endcapture -%}
+      <div class="add-on-product-style add-on-product-style-theftloss">
+        <input
+          id="theftloss-product-mpn"
+          type="hidden"
+          name="properties[theftloss-product-mpn]"
+          value="{{ theftLossProduct.metafields.apple.apl_MPN.value | escape }}"
+        >
+        <input
+          id="theftloss-product-sku"
+          type="hidden"
+          name="properties[theftloss-product-sku]"
+          value="{{ this_variant_tl.sku }}"
+        >
+        <input
+          id="theftloss-product-handle"
+          type="hidden"
+          name="properties[theftloss-product-handle]"
+          value="{{ theftLossProduct.handle }}"
+        >
+        <div class="add-on-product-container1">
+          <h2 class="apl-section-theftloss-title">{{ theftLossMetaobject.pdp_component_header_copy }}</h2>
+          <div class="container-box-2">
+            <div class="mobile-care-pdp">
+              <div class="left care-pdp-img apl-section-theftloss-image">
+                <span class="care-img">
+                  <img
+                    src="{{ theftLossMetaobject.pdp_component_apple_care_media_asset | image_url: height: 100 }}"
+                    loading="lazy"
+                    class="add-on-image"
+                    width="100"
+                    height="100"
+                    alt="{{ 'sections.add_ons.care_image' | t }}"
+                  >
+                </span>
+              </div>
+              <div class="care-pdp-title">
+                <span class="add-on-element care-info">
+                  <span class="apl-section-theftloss-description">
+                    {{ theftLossMetaobject.pdp_component_description_copy }}
+                  </span>
+                  <span class="apl-section-theftloss-price">{{ theftLossProduct.price | money_with_currency }}</span>
+
+                  {% if section.settings.enable_learn_more %}
+                    <div class="care-info-learn-more apl-section-theftloss-learn">
+                      {%
+                        render 'apple-care-modal',
+                        section_id: tl_modal_section_id,
+                        metaobject: theftLossMetaobject
+                      %}
+                    </div>
+                  {% endif %}
+                  {%- if tl_acceptance_metaobject != blank -%}
+                    {%
+                      render 'apple-care-acceptance-modal',
+                      section_id: tl_acceptance_modal_section_id,
+                      metaobject: tl_acceptance_metaobject
+                    %}
+                  {%- endif -%}
+                </span>
+              </div>
+              <input type="hidden" id="theftloss-care-varid" name="id" value="{{ this_variant_tl.id }}">
+              <span class="add-on-element" aria-hidden="true">
+                <input
+                  class="add-on-product-checkbox js-modify-price-display"
+                  id="add-theftloss"
+                  type="checkbox"
+                  name="id[]"
+                  value="{{ this_variant_tl.id }}"
+                  autocomplete="off"
+                  data-price-raw-modify-by="{{ theftLossProduct.price }}"
+                >
+              </span>
+            </div>
+            <div>
+              <button
+                type="button"
+                data-index="{{ this_variant_tl.id }}"
+                id="theftloss-add"
+                class="add-on-product-button"
+                aria-label="{{ 'products.product.add_button_for_applecare' | t }}"
+                {% if tl_acceptance_metaobject != blank %}
+                  data-tl-popup-trigger="true"
+                  data-tl-popup-skip-if-checked="add-theftloss"
+                  data-tl-modal-id="modal-{{ tl_acceptance_modal_section_id }}"
+                {% endif %}
+              >
+                <div class="pdp-care-btn btn product-form__submit apl-section-theftloss-add-remove">
+                  {{ 'products.product.add_button_for_applecare' | t }}
+                </div>
+              </button>
+            </div>
+          </div>
+        </div>
+      </div>
+    {%- endif -%}
+  {%- endif -%}
+</div>

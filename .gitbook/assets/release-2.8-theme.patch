+          {%- else -%}
+            {%- assign i = index -%}
+            {%- assign is_base_option = false -%}
+          {%- endif -%}
+
+          {%- assign meta_lable = 'apl_Option' | append: i | append: 'Label' -%}
+          {%- assign prod_meta_value = 'apl_Option' | append: i | append: 'Value' -%}
+
+          {%- if is_base_option -%}
+            {%- assign meta_lable = 'apl_app_BaseOption' | append: i | append: 'Label' -%}
+            {%- assign prod_meta_value = 'apl_app_BaseOption' | append: i | append: 'Value' -%}
+          {%- endif -%}
+
+          {%- if is_base_option -%}
+          {%- elsif collection.metafields.apple[meta_lable].value != blank -%}
+            {%- if product.metafields.apple[prod_meta_value].value == blank -%}
+              {%- assign prod_meta_value = 'apl_cto_Option' | append: i | append: 'Value' -%}
+            {%- endif -%}
+          {%- else -%}
+            {%- assign meta_lable = 'apl_cto_Option' | append: i | append: 'Label' -%}
+            {%- assign prod_meta_value = 'apl_cto_Option' | append: i | append: 'Value' -%}
+          {%- endif -%}
+
+          {%- assign opt_value = product.metafields.apple[prod_meta_value].value -%}
+          {%- if opt_value != blank -%}
+            {%- assign opt_value_str = opt_value | strip -%}
+            {%- assign po2_entry = opt_value_str | append: 'option' | append: i -%}
+            {%- unless prod_option2_first -%},{%- endunless -%}
+            {%- assign prod_option2_first = false -%}
+            {{- po2_entry | json -}}
+          {%- endif -%}
+        {%- endfor -%}
+      {%- endcapture -%}
+
+      {%- capture nmp_html -%}
+        {%- render 'net-monthly-pricing', placement: 'pdp', product_price: product.selected_or_first_available_variant.price -%}
+      {%- endcapture -%}
+
+      {
+        "variant_id": {{ product.variants[0].id | json }},
+        "available": {{ product.available | json }},
+        "handle": {{ product.handle | json }},
+        "url": {{ product.url | json }},
+        "id": {{ product.selected_or_first_available_variant.id | json }},
+        "product_id": {{ product.id | json }},
+        "product_title": {{ product.title | escape | json }},
+        "product_type": {{ product.type | json }},
+        "product_sku": {{ product.metafields.apple.apl_MPN.value | default: product.selected_or_first_available_variant.sku | json }},
+        "product_price": {{ product.selected_or_first_available_variant.price | money_without_currency | json }},
+        "price_amount": {{ product.selected_or_first_available_variant.price | json }},
+        "price_max": {{ product.price_max | json }},
+        "price_max_formatted": {{ product.price_max | money_with_currency | json }},
+        "compare_at_price": {{ product.selected_or_first_available_variant.compare_at_price | money_without_currency | json }},
+        "options": { {{- options_json -}} },
+        "options_pipe": {{ options_pipe | json }},
+        "options_pipe_with_label": {{ options_pipe_with_label | json }},
+        "prod_option2_entries": [ {{- prod_option2_json -}} ],
+        "color_value": {{ color_value | json }},
+        "color_swatch_url": {{ color_swatch_url | strip | json }},
+        "band_color_value": {{ band_color_value | json }},
+        "band_color_swatch_url": {{ band_color_swatch_url | strip | json }},
+        "nmp_html": {{ nmp_html | json }}
+      }{%- unless forloop.last -%},{%- endunless -%}
+    {%- endfor -%}
+  ]
+}
+</script>

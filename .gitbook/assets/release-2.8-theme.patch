new file mode 100644
index 0000000000000000000000000000000000000000..b0b63cabab921327b9e17924b674bba8b74875b9
--- /dev/null
+++ b/theme/sections/product-pre-sale-check.liquid
@@ -0,0 +1,15 @@
+{%- comment -%}
+  Data-only section used by recommendations-slider.js via the Section Rendering API.
+  Returns the pre-sale status of a product by looking up its base smart collection's
+  apl_EnablePreSaleStatus metafield. Called as: /products/{handle}?sections=product-pre-sale-check
+{%- endcomment -%}
+{%- assign productBaseCollection = product.metafields.apple.apl_BaseProductCollectionHandle.value.handle -%}
+{%- if productBaseCollection == blank -%}
+  {%- assign productBaseCollection = product.metafields.apple.apl_BaseProductCollection.value -%}
+{%- endif -%}
+{%- assign productSmarts = collections[productBaseCollection] -%}
+{%- assign is_pre_sale = productSmarts.metafields.apple.apl_EnablePreSaleStatus.value | default: false -%}
+<script type="application/json" data-product-pre-sale>{% if is_pre_sale %}true{% else %}false{% endif %}</script>
+{% schema %}
+{ "name": "Product Pre-Sale Check", "settings": [] }
+{% endschema %}

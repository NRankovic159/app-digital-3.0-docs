+// Safari/VoiceOver caches the accessible name from descendant text and doesn't refresh it
+// when nested innerHTML mutates. Mirroring the visible label into aria-label on the <summary>
+// forces WebKit to recompute the AX name on next focus.
+window.refreshSummaryAriaLabel = function (elementInsideSummary) {
+  const node = elementInsideSummary?.jquery ? elementInsideSummary[0] : elementInsideSummary;
+  if (!node) return;
+  const summary = node.tagName === 'SUMMARY' ? node : node.closest?.('summary');
+  if (!summary) return;
+  summary.setAttribute('aria-label', summary.textContent.replace(/\s+/g, ' ').trim());
+};
+
+const CART_QTY_SEPARATORS = { row: ',#', col: '<--split-->' };
+const CART_QTY_KEY_PREFIX = { ctoChild: 'bundle-cto-child-', nativeComponent: 'bundle-component-' };
+
+/**
+ * Cart quantity aggregation shared by every add-to-cart / checkout quantity-limit gate.
+ *
+ * Source of truth is the `cart?view=minquant` row feed rather than /cart.js, because units that
+ * live inside a bundle are invisible to /cart.js: a custom (CTO) bundle is a single line whose
+ * variant is the hero child (the other children exist only as `_bundle_item_N_id` properties),
+ * and a native Shopify bundle keeps its children in `item_components`. minquant emits a synthetic
+ * row per bundle child so those units can be aggregated by product id.
+ *
+ * See theme/templates/cart.minquant.liquid for the row format and key taxonomy.
+ */
+window.CartQuantity = (() => {
+  let rowsCache = null;
+
+  const parseRows = (text) =>
+    String(text)
+      .trim()
+      .split(CART_QTY_SEPARATORS.row)
+      .filter((chunk) => chunk.trim() !== '')
+      .map((chunk) => chunk.split(CART_QTY_SEPARATORS.col).map((col) => col.trim()));
+
+  // Tolerates an untrimmed row, since a caller may hand over a raw String.split() result.
+  const isCtoChildRow = (row) =>
+    Array.isArray(row) && typeof row[3] === 'string' && row[3].trim().startsWith(CART_QTY_KEY_PREFIX.ctoChild);
+
+  const isAddOnRow = (row) => row?.[7] === 'AppleCare' || row?.[7] === 'SecondWarranty';
+
+  /**
+   * Blocking on purpose: every caller is a synchronous add-to-cart / checkout gate that must
+   * decide before the click proceeds. Memoised for the CURRENT SYNCHRONOUS TURN ONLY (dropped on
+   * the next microtask, which flushes before any network callback or subsequent event), so a gate
+   * that inspects many products — the frequently-bought-together loop, or every child of a bundle
+   * — issues one request instead of N, yet can never act on a snapshot from an earlier turn.
+   */
+  const getRows = () => {
+    if (rowsCache) return rowsCache;
+
+    let rows = [];
+    try {
+      $.ajax({
+        type: 'GET',
+        async: false,
+        url: `${window.Shopify.routes.root}cart?view=minquant`,
+        success: (data) => {
+          rows = parseRows(data);
+        },
+      });
+    } catch (e) {
+      rows = [];
+    }
+
+    rowsCache = rows;
+    Promise.resolve().then(() => {
+      rowsCache = null;
+    });
+    return rows;
+  };
+
+  /**
+   * Total units of a product across the whole cart.
+   *
+   * @param {number|string} productId
+   * @param {Object} [options]
+   * @param {boolean} [options.includeCtoChildren=true] `true` for MAX-limit checks: units sitting
+   *   inside a CTO bundle count toward the product's purchase limit. `false` for INVENTORY checks:
+   *   a CTO bundle line only consumes the hero variant's inventory, never the other children's, so
+   *   counting them there would invent a restriction that no stock level backs.
+   * @param {Array[]} [options.rows] Pre-fetched rows, to keep a multi-product gate at one request.
+   */
+  const sumByProductId = (productId, { includeCtoChildren = true, rows } = {}) => {
+    if (productId === undefined || productId === null || productId === '') return 0;
+
+    return (rows ?? getRows()).reduce((total, row) => {
+      // Loose equality: minquant columns arrive as strings, callers pass numbers or strings.
+      if (row[0] != productId) return total;
+      if (!includeCtoChildren && isCtoChildRow(row)) return total;
+      return total + (parseInt(row[1], 10) || 0);
+    }, 0);
+  };
+
+  return { KEY_PREFIX: CART_QTY_KEY_PREFIX, parseRows, isCtoChildRow, isAddOnRow, getRows, sumByProductId };
+})();
+

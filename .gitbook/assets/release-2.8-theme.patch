diff --git a/theme/snippets/slideshow-video-autopause.liquid b/theme/snippets/slideshow-video-autopause.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..f22aba0ca22f42bb495992c64a6275175d9c8fd4
--- /dev/null
+++ b/theme/snippets/slideshow-video-autopause.liquid
@@ -0,0 +1,40 @@
+{%- comment -%}
+  Slideshow Video Autopause
+
+  When the global `autopause_carousel_videos` setting is on, autoplay
+  videos inside `<slideshow-component>` sections are paused 5 seconds
+  after each `playing` event so the page can satisfy WCAG 2.2.2
+  (Pause, Stop, Hide) without an in-slide play/pause control.
+
+  Re-arms on every `playing` event because the carousel restarts the
+  video each time the user navigates back to the slide.
+{%- endcomment -%}
+
+{%- if settings.autopause_carousel_videos -%}
+  <script>
+    (function () {
+      var DELAY_MS = 5000;
+
+      function arm(video) {
+        if (video.dataset.a11yAutopauseArmed) return;
+        video.dataset.a11yAutopauseArmed = 'true';
+        video.addEventListener('playing', function () {
+          clearTimeout(video._a11yAutopauseTimer);
+          video._a11yAutopauseTimer = setTimeout(function () {
+            try { video.pause(); } catch (e) {}
+          }, DELAY_MS);
+        });
+      }
+
+      function init() {
+        document.querySelectorAll('slideshow-component video').forEach(arm);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
+{%- endif -%}

diff --git a/theme/sections/cto-configurations-page.liquid b/theme/sections/cto-configurations-page.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..9813c6d7c64af7af15d1d759e4d0482bd66b2549
--- /dev/null
+++ b/theme/sections/cto-configurations-page.liquid
@@ -0,0 +1,191 @@
+{%- comment -%}
+  CTO Configurations Page
+
+  JSON endpoint that returns one paginated page (max 250) of products in a base
+  collection together with all data needed to merge into the prod_option /
+  prod_option_obj arrays built server-side by snippets/cto-configurable.liquid
+  and snippets/product-variant-scripts.liquid. Used only when the base
+  collection has more than 250 products and the configurator must AJAX-fetch
+  the rest.
+
+  Invoked via the Section Rendering API:
+    /collections/{base-handle}?section_id=cto-configurations-page&page=N
+{%- endcomment -%}
+
+{%- paginate collection.products by 250 -%}
+<script type="application/json" id="cto-configs-json">
+{
+  "page": {{ paginate.current_page | json }},
+  "pages": {{ paginate.pages | json }},
+  "items": {{ paginate.items | json }},
+  "products": [
+    {%- for product in collection.products -%}
+      {%- comment -%} Resolve color / band-color option indices on the collection {%- endcomment -%}
+      {%- assign color_option_index = 0 -%}
+      {%- assign band_color_option_index = 0 -%}
+      {%- for i in (1..7) -%}
+        {%- assign opt_label_key = 'apl_Option' | append: i | append: 'Label' -%}
+        {%- if collection.metafields.apple[opt_label_key] != blank -%}
+          {%- assign option_name = collection.metafields.apple[opt_label_key] | strip -%}
+          {%- if option_name == settings.color_translation or option_name == settings.case_finish_translation -%}
+            {%- assign color_option_index = i -%}
+          {%- elsif option_name == settings.band_color_translation -%}
+            {%- assign band_color_option_index = i -%}
+          {%- endif -%}
+        {%- endif -%}
+      {%- endfor -%}
+
+      {%- assign color_value = '' -%}
+      {%- assign color_swatch_url = '' -%}
+      {%- if color_option_index > 0 -%}
+        {%- assign color_value_key = 'apl_Option' | append: color_option_index | append: 'Value' -%}
+        {%- assign color_value = product.metafields.apple[color_value_key].value | strip -%}
+        {%- if product.metafields.apple.apl_ColorSwatchImageFile.value != blank -%}
+          {%- assign color_swatch_url = product.metafields.apple.apl_ColorSwatchImageFile.value | image_url: width: 48 -%}
+        {%- else -%}
+          {%- assign color_swatch_url = product.metafields.apple.apl_VariantColorSwatchImageURL.value -%}
+        {%- endif -%}
+      {%- endif -%}
+
+      {%- assign band_color_value = '' -%}
+      {%- assign band_color_swatch_url = '' -%}
+      {%- if band_color_option_index > 0 -%}
+        {%- assign band_color_value_key = 'apl_Option' | append: band_color_option_index | append: 'Value' -%}
+        {%- assign band_color_value = product.metafields.apple[band_color_value_key].value | strip -%}
+        {%- if product.metafields.apple.apl_BandColorSwatchImageFile.value != blank -%}
+          {%- assign band_color_swatch_url = product.metafields.apple.apl_BandColorSwatchImageFile.value | image_url: width: 48 -%}
+        {%- else -%}
+          {%- assign band_color_swatch_url = product.metafields.apple.apl_BandColorSwatchImageURL.value -%}
+        {%- endif -%}
+      {%- endif -%}

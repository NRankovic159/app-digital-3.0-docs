+  }
+
+  /* Mobile video wrapper. Reserves layout space so the deferred (preload: none)
+     video does not shift content when it paints. Default 16/9 matches the
+     1920x1080 homepage film; a cover image's ratio arrives as the inline
+     style="aspect-ratio:…" and overrides it.
+     The selectors below are 0,5,0+ to out-specify two shared rules:
+     - Dawn's `.media > :not(.zoom):not(.deferred-media__poster-button):not(.image_banner)`
+       (base.min.css, 0,4,0) makes the wrapper position: absolute; height: 100% of a
+       0px-tall .media, which disables aspect-ratio and clips the video behind
+       .media's overflow: hidden (invisible banner);
+     - `.banner-mobile .slideshow__media.banner__media.media video { width: auto }`
+       (custom-style.css, 0,4,1) sizes the video to its intrinsic width. */
+  .banner-mobile .slideshow__media.banner__media.media > .apl-section-slider-clickable__video-ratio {
+    position: relative;
+    display: block;
+    width: 100%;
+    height: auto;
+    aspect-ratio: 16 / 9;
+  }
+
+  .banner-mobile .slideshow__media.banner__media.media > .apl-section-slider-clickable__video-ratio video {
+    display: block;
+    width: 100%;
+    height: auto;
+  }
+
+  /* With a cover image the box has the poster's ratio: fill it, and object-fit:
+     cover crops any poster/video ratio mismatch. */
+  .banner-mobile .slideshow__media.banner__media.media > .apl-section-slider-clickable__video-ratio[style*="aspect-ratio"] video {
+    height: 100%;
+    object-fit: cover;
+  }

diff --git a/theme/snippets/product-max-quantity-limit.liquid b/theme/snippets/product-max-quantity-limit.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..3915a257df0fc5d585d474305f7f900be5286bcb
--- /dev/null
+++ b/theme/snippets/product-max-quantity-limit.liquid
@@ -0,0 +1,44 @@
+{%- comment -%}
+  Effective purchase limit for a product, emitted as a bare number (empty when there is no limit).
+
+  A product's limit can come from EITHER source, independently:
+    - `variant.quantity_rule.max` — Shopify's native per-variant quantity rule, which
+      main-product.liquid renders as the quantity input's `max`.
+    - the `apl_MaxQuantityLimit` product metafield — rendered by buy-buttons.liquid as
+      `#product_max_quantity`.
+
+  The PDP enforces both, so the equivalent single value for the add-to-cart gates in
+  product-form.js is whichever is lower. Those gates skip their check entirely when handed an
+  empty string, so a card that reads only the metafield lets a shopper add on top of an
+  already-full quantity_rule limit.
+
+  A missing, non-numeric or non-positive value on either side means "no limit from that source",
+  matching how the gates already treat an absent limit — a 0 here would otherwise block the
+  product from being bought at all.
+
+  Emits nothing but the value, so it is safe inside an HTML attribute.
+
+  Params:
+  - product {Object} the product to read the limit from
+
+  Usage:
+  {%- render 'product-max-quantity-limit', product: card_product -%}
+{%- endcomment -%}
+{%- liquid
+  assign rule_max = product.selected_or_first_available_variant.quantity_rule.max | times: 1
+  assign metafield_max = product.metafields.apple.apl_MaxQuantityLimit.value | times: 1
+  assign effective_max = ''
+
+  if rule_max > 0 and metafield_max > 0
+    if rule_max < metafield_max
+      assign effective_max = rule_max
+    else
+      assign effective_max = metafield_max
+    endif
+  elsif rule_max > 0
+    assign effective_max = rule_max
+  elsif metafield_max > 0
+    assign effective_max = metafield_max
+  endif
+-%}
+{{- effective_max -}}

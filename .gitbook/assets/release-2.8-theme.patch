diff --git a/theme/snippets/theftloss-service-overview-scripts.liquid b/theme/snippets/theftloss-service-overview-scripts.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..0db43953498f8e4bc6ff05168a5f3f6db878d4e4
--- /dev/null
+++ b/theme/snippets/theftloss-service-overview-scripts.liquid
@@ -0,0 +1,135 @@
+{%- comment -%}
+  Active-Acceptance interceptor for AppleCare+ with Theft & Loss.
+
+  Active Acceptance is enabled per-product when the parent T&L metaobject's
+  `pdp_component_active_acceptance` reference points at a populated
+  `applecare_pdp_component_acceptance_modal` metaobject. T&L tile CTAs only
+  render `data-tl-popup-trigger="true"` when that reference is present, so
+  the interceptor can run unconditionally and only engages on opted-in tiles.
+
+  Behavior: the modal opens on **every** tile click that would add T&L —
+  there is no persistent "already accepted" memo. The `data-tl-popup-confirmed`
+  flag is a one-shot, set on the tile only for the duration of the re-fired
+  click after the user accepts in the modal, then immediately cleared so the
+  next click reopens the modal.
+
+  Skip cases:
+  - Unchecking (the associated `skip-if-checked` checkbox is currently checked)
+    is passed through unmodified; the `data-customer-accept-terms` flag on the
+    checkbox is cleared at the same time so the next add starts clean.
+
+  Acceptance flow:
+  - Tile click → modal opens.
+  - Modal CTA click → set `data-customer-accept-terms="Y"` on the tile and the
+    associated `#add-theftloss` checkbox, set the one-shot confirmation flag,
+    re-fire the tile click, clear the one-shot flag. The downstream handlers
+    (PDP checkbox toggle, CTO radio, `.add-cart-apple-care`) run during the
+    re-fired click. `product-form.js` reads `data-customer-accept-terms="Y"`
+    when constructing the line item and attaches `_customerAcceptTerms: 'Y'`
+    to the T&L line-item properties.
+{%- endcomment -%}
+
+<script>
+  (function () {
+    var pendingTrigger = null;
+
+    function findModalRoot(modalId) {
+      if (!modalId) return null;
+      var modalContent = document.getElementById(modalId);
+      if (!modalContent) return null;
+      return modalContent.closest('.modal') || modalContent;
+    }
+
+    function closeSeedkitModal(modalRoot) {
+      if (!modalRoot) return;
+      // Seedkit close button is injected with data-modal-element-close-button.
+      var closeBtn = modalRoot.querySelector('[data-modal-element-close-button]') || modalRoot.querySelector('.modal__close');
+      if (closeBtn) {
+        closeBtn.click();
+        return;
+      }
+      // Fallback: remove the open class so the modal hides.
+      modalRoot.classList.remove('modal-open');
+      modalRoot.setAttribute('aria-hidden', 'true');
+    }
+
+    // Capture-phase interceptor on tile CTAs.
+    document.addEventListener('click', function (event) {
+      var target = event.target;
+      if (!target || !target.closest) return;
+
+      var trigger = target.closest('[data-tl-popup-trigger="true"]');
+      if (!trigger) return;
+
+      var innerAnchor = target.closest('a[href]');
+      if (innerAnchor && innerAnchor !== trigger && trigger.contains(innerAnchor)) {
+        var href = innerAnchor.getAttribute('href') || '';
+        if (href && href !== '#' && href.indexOf('javascript:') !== 0) {
+          event.stopPropagation();
+          event.stopImmediatePropagation();
+          return;
+        }
+      }
+
+      // Re-fired click after acceptance — let it pass through to the underlying handler.
+      if (trigger.getAttribute('data-tl-popup-confirmed') === 'true') {
+        return;
+      }
+
+      // Unchecking — pass through, and clear any stale acceptance flag on the checkbox.
+      var skipId = trigger.getAttribute('data-tl-popup-skip-if-checked');
+      var skipCheckbox = skipId ? document.getElementById(skipId) : null;
+      if (skipCheckbox && skipCheckbox.checked) {
+        skipCheckbox.removeAttribute('data-customer-accept-terms');
+        return;
+      }
+
+      // First-time (or re-add) click — open the modal.
+      var modalId = trigger.getAttribute('data-tl-modal-id');
+      if (!modalId) return;
+      var modalOpenLink = document.querySelector('.ac-modal-trigger[data-modal-target="' + modalId + '"]');
+      if (!modalOpenLink) return;
+
+      event.preventDefault();
+      event.stopPropagation();
+      event.stopImmediatePropagation();
+
+      pendingTrigger = trigger;
+      modalOpenLink.click();
+    }, true);
+
+    // Modal CTA button -> confirm + close + re-fire tile click + clear one-shot flag.
+    document.addEventListener('click', function (event) {
+      var addBtn = event.target && event.target.closest && event.target.closest('.js-tl-modal-add');
+      if (!addBtn) return;
+
+      event.preventDefault();
+
+      var modalId = addBtn.getAttribute('data-tl-modal-id');
+      var trigger = pendingTrigger;
+      pendingTrigger = null;
+
+      if (trigger) {
+        trigger.setAttribute('data-tl-popup-confirmed', 'true');
+        trigger.setAttribute('data-customer-accept-terms', 'Y');
+        var associatedCheckbox = document.getElementById('add-theftloss');
+        if (associatedCheckbox) {
+          associatedCheckbox.setAttribute('data-customer-accept-terms', 'Y');
+        }
+      }
+
+      closeSeedkitModal(findModalRoot(modalId));
+
+      if (trigger) {
+        trigger.click();
+        trigger.removeAttribute('data-tl-popup-confirmed');
+        trigger.removeAttribute('data-customer-accept-terms');
+
+        // Dispatch `change` so CTO listeners (grey-out, accordion) react to the addition.
+        if (associatedCheckbox) {
+          associatedCheckbox.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+      }
+    });
+  })();
+</script>

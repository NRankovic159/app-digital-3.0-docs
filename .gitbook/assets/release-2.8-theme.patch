+{%- comment -%}
+  Apple Care Acceptance Modal
+
+  Rendered alongside (but separate from) the Apple Care Learn More modal.
+  Opened programmatically by the T&L tile interceptor in
+  `theftloss-service-overview-scripts`; the trigger is hidden via
+  `hide_trigger: true` on `ac-modal`.
+
+  @param {string} section_id - unique id for the modal (used as `modal-{section_id}`)
+  @param {object} metaobject - `applecare_pdp_component_acceptance_modal` metaobject
+{%- endcomment -%}
+
+{%- assign logo = metaobject.pdp_modal_logo -%}
+{%- assign title = metaobject.pdp_modal_title -%}
+{%- assign description = metaobject.pdp_modal_description_copy -%}
+{%- assign learn_more_link = metaobject.pdp_modal_learn_more_link.value -%}
+{%- assign cta_copy = metaobject.pdp_modal_cta_copy -%}
+{%- assign terms_and_conditions = metaobject.pdp_modal_terms_conditions -%}
+
+{%- capture modal_content -%}
+  {%- if logo != blank -%}
+    {{
+      logo
+      | image_url: width: 100
+      | image_tag: class: 'apple-care-acceptance-modal__logo', alt: '', loading: 'lazy'
+    }}
+  {%- endif -%}
+  {%- if title != blank -%}
+    <h2 id="ac-modal-heading-{{ section_id }}" class="apple-care-acceptance-modal__heading">{{ title }}</h2>
+  {%- endif -%}
+  <div class="apple-care-acceptance-modal__content">
+    {%- if description != blank -%}
+      {{- description | metafield_tag -}}
+    {%- endif -%}
+    <div class="apple-care-acceptance-modal__actions">
+      {%- if learn_more_link != blank -%}
+        <a
+          class="apple-care-acceptance-modal__learn-more"
+          href="{{ learn_more_link.url }}"
+          target="_blank"
+          rel="noopener noreferrer"
+        ><span class="apple-care-acceptance-modal__learn-more-text">{{ learn_more_link.text | strip }}</span></a>
+      {%- endif -%}
+      {%- if cta_copy != blank -%}
+        <button
+          type="button"
+          class="apple-care-acceptance-modal__cta button button--primary js-tl-modal-add"
+          data-tl-modal-id="modal-{{ section_id }}"
+        >
+          {{ cta_copy }}
+        </button>
+      {%- endif -%}
+    </div>
+    {%- if terms_and_conditions != blank -%}
+      <div class="apple-care-acceptance-modal__tcs">
+        {{- terms_and_conditions | metafield_tag -}}
+      </div>
+    {%- endif -%}
+  </div>
+{%- endcapture -%}
+
+{%
+  render 'ac-modal',
+  section_id: section_id,
+  modal_content: modal_content,
+  modal_alt_text: title,
+  custom_modal_class: 'apple-care-acceptance-modal',
+  show_trigger_icon: false,
+  hide_trigger: true
+%}

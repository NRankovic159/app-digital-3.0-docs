+{%- comment -%}
+  Lowest-price sync.
+
+  A `paginate` tag can only read one 250-product slice of a collection per request, and which
+  slice it gets is dictated by the `page` URL parameter — the same one the product grid paginates
+  with. So the scan that resolves a card's "From" price sees slice N of the linked collection on
+  page N of a PLP: past the end of the collection it resolves nothing, and inside it resolves the
+  cheapest of that slice rather than of the collection. The same 250 limit also caps page 1, where
+  a collection larger than 250 products is only ever partly scanned.
+
+  Each card therefore advertises which slice its price came from (`data-lob-slice`), how many
+  slices its collection spans (`data-lob-slices`, from the real product count), and the raw price
+  it resolved (`data-lob-price`, absent when the value is only a fallback). This script re-renders
+  the section for the slices the current request could not read, keeps the lowest price across all
+  of them, and patches in that product's price, badges and link.
+
+  Cost: no request at all when every card's collection fits in the slice already rendered — the
+  common case of page 1 with collections under 250 products, and every PDP. Otherwise one
+  low-priority request per missing slice, shared by all cards and cached in sessionStorage for the
+  rest of the session, so paging through a PLP does not refetch. Cards keep a real price
+  throughout; the sync only ever lowers it.
+{%- endcomment -%}
+<script>
+  (() => {
+    const CACHE_PREFIX = `lob-stripe-price:{{ section.id }}:{{ localization.country.iso_code }}-{{ localization.language.iso_code }}-{{ cart.currency.iso_code }}-{{ customer.id | default: 0 }}:`;
+    const CARD_SELECTOR = '.apl_lob_list_item[data-lob-slices]';
+    const RESOLVED_PRICE_SELECTOR = '.apl_lob_price[data-lob-price]';
+
+    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
+    if (!sectionEl) return;
+
+    // Absent on a card the render could only give a fallback price to, which must never win a
+    // comparison — hence NaN rather than 0 for anything unusable.
+    const priceElOf = (card) => card.querySelector(RESOLVED_PRICE_SELECTOR);
+    const priceOf = (priceEl) => {
+      const price = priceEl?.dataset.lobPrice ? Number(priceEl.dataset.lobPrice) : NaN;
+      return Number.isFinite(price) ? price : NaN;
+    };
+
+    // Slices no render on this page has read yet. One render carries every card, so the set is
+    // shared: eight stale cards on page 2 still come down in a single request.
+    const missingSlices = () => {
+      const slices = new Set();
+
+      for (const card of sectionEl.querySelectorAll(CARD_SELECTOR)) {
+        const total = Number(card.dataset.lobSlices) || 1;
+        const rendered = Number(card.dataset.lobSlice) || 1;
+        // This render already scanned the collection end to end.
+        if (total === 1 && rendered === 1) continue;
+
+        for (let slice = 1; slice <= total; slice += 1) {
+          if (slice !== rendered) slices.add(slice);
+        }
+      }
+
+      return [...slices];
+    };
+
+    const wantedSlices = missingSlices();
+    if (!wantedSlices.length) return;
+
+    // Reduce a rendered section to each card's price candidate, keyed by card.
+    const collectCandidates = (doc) => {
+      const candidates = {};
+
+      for (const card of doc.querySelectorAll(CARD_SELECTOR)) {
+        const priceEl = priceElOf(card);
+        const price = priceOf(priceEl);
+        if (Number.isNaN(price)) continue;
+
+        candidates[card.dataset.lobStripeKey] = {
+          price,
+          priceHtml: priceEl.outerHTML,
+          badgesHtml: card.querySelector('.tagcontainer')?.innerHTML ?? null,
+          imageHtml: card.querySelector('.imagecontainer')?.outerHTML ?? null,
+          href: card.querySelector('a')?.getAttribute('href') ?? null,
+        };
+      }
+
+      return candidates;
+    };
+
+    const readCache = (key) => {
+      try {
+        return JSON.parse(sessionStorage.getItem(key));
+      } catch {
+        return null; // Private mode, or unparseable — fall through to the network.
+      }
+    };
+
+    const writeCache = (key, value) => {
+      try {
+        sessionStorage.setItem(key, JSON.stringify(value));
+      } catch {
+        // Nothing to do; the sync works without the cache.
+      }
+    };
+
+    const fetchSlice = async (slice) => {
+      const cacheKey = `${CACHE_PREFIX}${window.location.pathname}:${slice}`;
+      const cached = readCache(cacheKey);
+      if (cached) return cached;
+
+      const url = `${window.location.pathname}?section_id={{ section.id }}&page=${slice}`;
+      const response = await fetch(url, { priority: 'low' });
+      if (!response.ok) throw new Error(`slice ${slice} responded ${response.status}`);
+
+      const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
+      const candidates = collectCandidates(doc);
+      writeCache(cacheKey, candidates);
+
+      return candidates;
+    };
+
+    // The lowest price found for this card across the fetched slices, or null when the price
+    // already on screen is the lowest.
+    const bestCandidate = (card, fetchedSlices) => {
+      const livePrice = priceOf(priceElOf(card));
+      let best = null;
+
+      for (const candidates of fetchedSlices) {
+        const candidate = candidates[card.dataset.lobStripeKey];
+        if (!candidate) continue;
+        if (!Number.isNaN(livePrice) && candidate.price >= livePrice) continue;
+        if (!best || candidate.price < best.price) best = candidate;
+      }
+
+      return best;
+    };
+
+    const applyCandidate = (card, candidate) => {
+      // Replaced whole so the classes of the winning render come across with it.
+      const priceEl = card.querySelector('.apl_lob_price');
+      if (priceEl && priceEl.outerHTML !== candidate.priceHtml) priceEl.outerHTML = candidate.priceHtml;
+
+      const badges = card.querySelector('.tagcontainer');
+      if (badges && candidate.badgesHtml !== null && badges.innerHTML !== candidate.badgesHtml) {
+        badges.innerHTML = candidate.badgesHtml;
+      }
+
+      const link = card.querySelector('a');
+      if (link && candidate.href && link.getAttribute('href') !== candidate.href) {
+        link.setAttribute('href', candidate.href);
+      }
+
+      // Only ever adds an image a failed scan left out; existing ones are not re-decoded.
+      const listLob = card.querySelector('.list-lob');
+      if (candidate.imageHtml && listLob && !card.querySelector('.imagecontainer')) {
+        listLob.insertAdjacentHTML('afterbegin', candidate.imageHtml);
+      }
+    };
+
+    (async () => {
+      try {
+        const fetchedSlices = await Promise.all(wantedSlices.map(fetchSlice));
+        let patched = false;
+
+        // Re-queried rather than reused: slick may have cloned the cards by now, and every clone
+        // needs the same price.
+        for (const card of sectionEl.querySelectorAll(CARD_SELECTOR)) {
+          const best = bestCandidate(card, fetchedSlices);
+          if (!best) continue;
+
+          applyCandidate(card, best);
+          patched = true;
+        }
+
+        if (!patched) return;
+
+        const slider = sectionEl.querySelector('.apl_lob_slider');
+        if (!slider) return;
+
+        // A price that was previously missing or shorter can change a card's width.
+        if (slider.classList.contains('slick-initialized')) $(slider).slick('setPosition');
+        setInitialSlideVisibility(slider);
+        adaFormatSlickSlides($(slider).find('.slick-list .slick-slide'));
+      } catch (error) {
+        // The rendered fallback price stays on screen.
+        console.error('Family Stripe lowest-price sync failed:', error);
+      }
+    })();
+  })();
+</script>
+

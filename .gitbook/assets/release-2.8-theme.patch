diff --git a/theme/sections/link-tabs.liquid b/theme/sections/link-tabs.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..35bf4b81202ccf40a621a40da2adfd676bea41fc
--- /dev/null
+++ b/theme/sections/link-tabs.liquid
@@ -0,0 +1,114 @@
+{{ 'section-link-tabs.css' | asset_url | stylesheet_tag }}
+
+{%- comment -%}
+  Paths are normalised with a trailing slash so '/pages/x' and '/pages/x/' match.
+  A link may be stored with or without the locale/market prefix, so both forms are checked.
+{%- endcomment -%}
+{%- liquid
+  assign current_path = request.path | downcase | append: '/' | replace: '//', '/'
+  assign locale_root = routes.root_url | downcase
+-%}
+
+{%- if section.blocks.size > 0 -%}
+  <nav
+    class="link-tabs"
+    {% if section.settings.nav_label != blank %}
+      aria-label="{{ section.settings.nav_label | escape }}"
+    {% endif %}
+  >
+    <ul class="link-tabs__list" role="list">
+      {%- for block in section.blocks -%}
+        {%- liquid
+          assign bs = block.settings
+          if bs.title == blank
+            continue
+          endif
+
+          assign is_active = false
+          if bs.link != blank
+            assign link_path = bs.link | downcase | split: '#' | first | split: '?' | first
+            if link_path contains '://'
+              assign link_path = link_path | split: '://' | last
+              assign link_host = link_path | split: '/' | first
+              assign link_path = link_path | remove_first: link_host
+              if link_host != request.host and link_host != shop.domain
+                assign link_path = nil
+              endif
+            endif
+
+            if link_path != nil
+              assign link_path = link_path | append: '/' | replace: '//', '/'
+              assign localized_link_path = locale_root | append: link_path | replace: '//', '/'
+              if link_path == current_path or localized_link_path == current_path
+                assign is_active = true
+              endif
+            endif
+          endif
+        -%}
+        <li class="link-tabs__item" {{ block.shopify_attributes }}>
+          <a
+            {% if bs.link == blank %}
+              role="link" aria-disabled="true"
+            {% else %}
+              href="{{ bs.link }}"
+            {% endif %}
+            class="link-tabs__link{% if is_active %} link-tabs__link--active{% endif %}"
+            {% if is_active %}
+              aria-current="page"
+            {% endif %}
+          >
+            {{- bs.title | escape -}}
+          </a>
+        </li>
+      {%- endfor -%}
+    </ul>
+  </nav>
+{%- endif -%}
+
+{% schema %}
+{
+  "name": "Link tabs",
+  "tag": "section",
+  "class": "section",
+  "disabled_on": {
+    "groups": ["header", "footer"]
+  },
+  "settings": [
+    {
+      "type": "text",
+      "id": "nav_label",
+      "label": "Navigation label",
+      "info": "Not visible. Read by screen readers to describe this group of links.",
+      "default": "Related pages"
+    }
+  ],
+  "blocks": [
+    {
+      "type": "link",
+      "name": "Link",
+      "settings": [
+        {
+          "type": "text",
+          "id": "title",
+          "label": "Label",
+          "default": "Link label"
+        },
+        {
+          "type": "url",
+          "id": "link",
+          "label": "Link"
+        }
+      ]

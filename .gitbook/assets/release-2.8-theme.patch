diff --git a/theme/snippets/collection-itemlist-schema.liquid b/theme/snippets/collection-itemlist-schema.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..3aea1f7f15ec4c6fdafe9ae9a14f6e7cfa9fbd80
--- /dev/null
+++ b/theme/snippets/collection-itemlist-schema.liquid
@@ -0,0 +1,100 @@
+{%- comment -%}
+  Renders ItemList schema.org structured data for collection/PLP pages.
+  On PLP templates (suffix contains "plp"): mirrors displayed products with OOS filtering
+  and lowest-priced-available swap.
+  On other templates: lists products from the collection as-is.
+  Usage: {% render 'collection-itemlist-schema', collection: collection, select_lowest_available: section.settings.select_lowest_available %}
+{%- endcomment -%}
+
+{%- if collection.products.size > 0 -%}
+  {%- assign position = 0 -%}
+  {%- assign is_plp = false -%}
+  {%- if collection.template_suffix contains 'plp' -%}
+    {%- assign is_plp = true -%}
+  {%- endif -%}
+
+  <script type="application/ld+json">
+    {
+      "@context": "https://schema.org",
+      "@type": "ItemList",
+      "name": {{ collection.title | json }},
+      "itemListElement": [
+        {%- for product in collection.products -%}
+          {%- unless product.tags contains 'apple_care' or product.tags contains 'apple_care_care+' -%}
+
+            {%- if is_plp -%}
+              {%- comment -%} PLP: Resolve base collection for OOS filtering {%- endcomment -%}
+              {%- assign base_handle = product.metafields.apple.apl_BaseProductCollectionHandle.value.handle -%}
+              {%- if base_handle == blank -%}
+                {%- assign base_handle = product.metafields.apple.apl_BaseProductCollection.value -%}
+              {%- endif -%}
+              {%- assign base_collection_products = collections[base_handle].products -%}
+
+              {%- comment -%} Check if all products (or all matching PrimaryDisplayTitle for iPhones) are OOS {%- endcomment -%}
+              {%- assign all_count = base_collection_products.size -%}
+              {%- assign available_products = base_collection_products | where: 'available' -%}
+              {%- assign oos_count = base_collection_products.size | minus: available_products.size -%}
+
+              {%- assign downcase_type = product.type | downcase -%}
+              {%- if downcase_type == 'iphone' -%}
+                {%- assign all_count = 0 -%}
+                {%- assign oos_count = 0 -%}
+                {%- for _product in base_collection_products -%}
+                  {%- if product.metafields.apple.apl_PrimaryDisplayTitle.value == _product.metafields.apple.apl_PrimaryDisplayTitle.value -%}
+                    {%- assign all_count = all_count | plus: 1 -%}
+                    {%- unless _product.available -%}
+                      {%- assign oos_count = oos_count | plus: 1 -%}
+                    {%- endunless -%}
+                  {%- endif -%}
+                {%- endfor -%}
+              {%- endif -%}
+
+              {%- comment -%} Skip fully OOS products (same logic as PLP grid) {%- endcomment -%}
+              {%- if product.available == false and all_count == oos_count -%}
+                {%- continue -%}
+              {%- endif -%}
+
+              {%- comment -%} Resolve displayed product via lowest-priced-available swap {%- endcomment -%}
+              {%- assign displayed_product = product -%}
+              {%- if select_lowest_available and base_handle != blank -%}
+                {%- assign sorted_base_products = collections[base_handle].products | sort: 'price_max' -%}
+                {%- assign lowest_price = blank -%}
+                {%- for smartProduct in sorted_base_products -%}
+                  {%- if lowest_price == blank or smartProduct.price < lowest_price -%}
+                    {%- if smartProduct.available and product.metafields.apple.apl_PrimaryDisplayTitle.value == smartProduct.metafields.apple.apl_PrimaryDisplayTitle.value -%}
+                      {%- assign displayed_product = smartProduct -%}
+                      {%- assign lowest_price = smartProduct.price -%}
+                      {%- break -%}
+                    {%- endif -%}
+                  {%- endif -%}
+                {%- endfor -%}
+              {%- endif -%}
+
+              {%- assign position = position | plus: 1 -%}
+              {%- if position > 1 -%},{%- endif -%}
+              {
+                "@type": "ListItem",
+                "position": {{ position }},
+                "url": {{ shop.url | append: displayed_product.url | json }},
+                "name": {{ displayed_product.title | json }}
+              }
+
+            {%- else -%}
+              {%- comment -%} Non-PLP: list products as set in admin {%- endcomment -%}
+              {%- assign position = position | plus: 1 -%}
+              {%- if position > 1 -%},{%- endif -%}
+              {
+                "@type": "ListItem",
+                "position": {{ position }},
+                "url": {{ shop.url | append: product.url | json }},
+                "name": {{ product.title | json }}
+              }
+            {%- endif -%}
+
+          {%- endunless -%}
+        {%- endfor -%}
+      ],
+      "numberOfItems": {{ position }}
+    }
+  </script>
+{%- endif -%}

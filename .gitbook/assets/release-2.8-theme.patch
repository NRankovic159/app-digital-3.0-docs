diff --git a/theme/sections/service-cta-card.liquid b/theme/sections/service-cta-card.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..2946f26a93d371f99ac6905f7678556d810bb5cd
--- /dev/null
+++ b/theme/sections/service-cta-card.liquid
@@ -0,0 +1,106 @@
+{{ 'section-service-cta-card.css' | asset_url | stylesheet_tag }}
+
+<div class="service-cta-card">
+  <div class="service-cta-card__inner" style="background-color: {{ section.settings.background_color }}; max-width: {{ section.settings.section_width }}px;">
+    <div class="service-cta-card__content">
+      {%- if section.settings.heading != blank -%}
+        <h2 class="service-cta-card__heading">{{ section.settings.heading }}</h2>
+      {%- endif -%}
+
+      {%- if section.settings.text != blank -%}
+        <p class="service-cta-card__text">{{ section.settings.text }}</p>
+      {%- endif -%}
+
+      {%- if section.settings.button_label != blank -%}
+        <div class="service-cta-card__button">
+          <a
+            {% if section.settings.button_link == blank %}
+              role="link" aria-disabled="true"
+            {% else %}
+              href="{{ section.settings.button_link }}"
+            {% endif %}
+            class="button button--primary"
+          >
+            {{- section.settings.button_label | escape -}}
+          </a>
+        </div>
+      {%- endif -%}
+    </div>
+
+    {%- if section.settings.image != blank -%}
+      <div class="service-cta-card__image">
+        {{
+          section.settings.image
+          | image_url: width: 1200
+          | image_tag:
+            loading: 'lazy',
+            sizes: '(min-width: 750px) 50vw, 100vw',
+            widths: '375, 550, 750, 1000, 1200',
+            alt: section.settings.image.alt
+        }}
+      </div>
+    {%- endif -%}
+  </div>
+</div>
+
+{% schema %}
+{
+  "name": "Service CTA card",
+  "tag": "section",
+  "class": "section",
+  "disabled_on": {
+    "groups": ["header", "footer"]
+  },
+  "settings": [
+    {
+      "type": "color",
+      "id": "background_color",
+      "label": "Background color",
+      "default": "#f5f5f7"
+    },
+    {
+      "type": "range",
+      "id": "section_width",
+      "min": 400,
+      "max": 1200,
+      "step": 20,
+      "unit": "px",
+      "label": "Section width",
+      "default": 600
+    },
+    {
+      "type": "inline_richtext",
+      "id": "heading",
+      "label": "Heading",
+      "default": "How to buy AppleCare+."
+    },
+    {
+      "type": "textarea",
+      "id": "text",
+      "label": "Text",
+      "default": "Add AppleCare+ at checkout when you purchase your Mac online or in store."
+    },
+    {
+      "type": "text",
+      "id": "button_label",
+      "label": "Button label",
+      "default": "Get coverage"
+    },
+    {
+      "type": "url",
+      "id": "button_link",
+      "label": "Button link"
+    },
+    {
+      "type": "image_picker",
+      "id": "image",
+      "label": "Image"
+    }
+  ],
+  "presets": [
+    {
+      "name": "Service CTA card"
+    }
+  ]
+}
+{% endschema %}
diff --git a/theme/sections/service-feature-grid.liquid b/theme/sections/service-feature-grid.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..7a8a2555150c2e01d46c604b99a038ce0e61e945
--- /dev/null
+++ b/theme/sections/service-feature-grid.liquid
@@ -0,0 +1,95 @@
+{{ 'section-service-feature-grid.css' | asset_url | stylesheet_tag }}
+
+<div class="service-feature-grid section-{{ section.id }}">
+  <div class="service-feature-grid__container page-width">
+    {%- if section.settings.heading != blank -%}
+      <h2 class="service-feature-grid__heading">{{ section.settings.heading }}</h2>
+    {%- endif -%}
+
+    {%- if section.blocks.size > 0 -%}
+      <div class="service-feature-grid__grid" role="list">
+        {%- for block in section.blocks -%}
+          <div class="service-feature-grid__card" role="listitem" {{ block.shopify_attributes }}>
+            {%- if block.settings.image != blank -%}
+              <div class="service-feature-grid__icon">
+                <div class="service-feature-grid__icon-wrapper">
+                  <img
+                    src="{{ block.settings.image | image_url: width: 128 }}"
+                    srcset="{{ block.settings.image | image_url: width: 64 }} 1x, {{ block.settings.image | image_url: width: 128 }} 2x"
+                    alt="{{ block.settings.image.alt | escape }}"
+                    width="64"
+                    height="{{ 64 | divided_by: block.settings.image.aspect_ratio | round }}"
+                    loading="lazy"
+                  >
+                </div>
+              </div>
+            {%- endif -%}
+
+            {%- if block.settings.heading != blank -%}
+              <h3 class="service-feature-grid__card-heading">{{ block.settings.heading }}</h3>
+            {%- endif -%}
+
+            {%- if block.settings.text != blank -%}
+              <p class="service-feature-grid__card-text">{{ block.settings.text }}</p>
+            {%- endif -%}
+          </div>
+        {%- endfor -%}
+      </div>
+    {%- endif -%}
+  </div>
+</div>
+
+{% schema %}
+{
+  "name": "Service feature grid",
+  "tag": "section",
+  "class": "section",
+  "disabled_on": {
+    "groups": ["header", "footer"]
+  },
+  "settings": [
+    {
+      "type": "inline_richtext",
+      "id": "heading",
+      "label": "Heading",
+      "default": "Covered from every angle."
+    }
+  ],
+  "blocks": [
+    {
+      "type": "feature_card",
+      "name": "Feature card",
+      "settings": [
+        {
+          "type": "image_picker",
+          "id": "image",
+          "label": "Icon / Image"
+        },
+        {
+          "type": "text",
+          "id": "heading",
+          "label": "Heading",
+          "default": "Feature heading"
+        },
+        {
+          "type": "textarea",
+          "id": "text",
+          "label": "Description",
+          "default": "Feature description text goes here."
+        }
+      ]
+    }
+  ],
+  "presets": [
+    {
+      "name": "Service feature grid",
+      "blocks": [
+        { "type": "feature_card" },
+        { "type": "feature_card" },
+        { "type": "feature_card" },
+        { "type": "feature_card" }
+      ]
+    }
+  ]
+}
+{% endschema %}
diff --git a/theme/sections/service-lob-module.liquid b/theme/sections/service-lob-module.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..14bc4f50367ae47fe0a5f2c9be5d755de1bf3008
--- /dev/null
+++ b/theme/sections/service-lob-module.liquid
@@ -0,0 +1,138 @@
+{{ 'section-service-lob-module.css' | asset_url | stylesheet_tag }}
+
+<div class="service-lob-module">
+  <div class="service-lob-module__inner">
+    <div class="service-lob-module__content">
+      <div class="service-lob-module__content-inner">
+        {%- assign has_links = false -%}
+        {%- for block in section.blocks -%}
+          {%- case block.type -%}
+            {%- when 'heading' -%}
+              {%- if block.settings.heading != blank -%}
+                <h2 class="service-lob-module__heading" {{ block.shopify_attributes }}>
+                  {{ block.settings.heading }}
+                </h2>
+              {%- endif -%}
+
+            {%- when 'text' -%}
+              {%- if block.settings.text != blank -%}
+                <div class="service-lob-module__text rte" {{ block.shopify_attributes }}>
+                  {{ block.settings.text }}
+                </div>
+              {%- endif -%}
+
+            {%- when 'link' -%}
+              {%- assign has_links = true -%}
+          {%- endcase -%}
+        {%- endfor -%}
+
+        {%- if has_links -%}
+          <nav class="service-lob-module__links" aria-label="{{ 'general.related_links' | t }}">
+          {%- for block in section.blocks -%}
+            {%- if block.type == 'link' and block.settings.label != blank -%}
+              <a
+                {% if block.settings.url != blank %}
+                  href="{{ block.settings.url }}"
+                {% else %}
+                  role="link" aria-disabled="true"
+                {% endif %}
+                class="service-lob-module__link"
+                {{ block.shopify_attributes }}
+              >
+                {{- block.settings.label | escape -}}
+                <i class="fa-solid fa-angle-right billboard_icon" aria-hidden="true"></i>
+              </a>
+            {%- endif -%}
+          {%- endfor -%}
+          </nav>
+        {%- endif -%}
+      </div>
+    </div>
+
+    {%- if section.settings.image != blank -%}
+      <div class="service-lob-module__image">
+        {{
+          section.settings.image
+          | image_url: width: 1200
+          | image_tag:
+            loading: 'lazy',
+            sizes: '(min-width: 750px) 50vw, 100vw',
+            widths: '375, 550, 750, 1000, 1200',
+            alt: section.settings.image.alt
+        }}
+      </div>
+    {%- endif -%}
+  </div>
+</div>
+
+{% schema %}
+{
+  "name": "Service LOB Module",
+  "tag": "section",
+  "class": "section",
+  "disabled_on": {
+    "groups": ["header", "footer"]
+  },
+  "settings": [
+    {
+      "type": "image_picker",
+      "id": "image",
+      "label": "Image"
+    }
+  ],
+  "blocks": [
+    {
+      "type": "heading",
+      "name": "Heading",
+      "settings": [
+        {
+          "type": "inline_richtext",
+          "id": "heading",
+          "label": "Heading",
+          "default": "AppleCare+ for iPad"
+        }
+      ]
+    },
+    {
+      "type": "text",
+      "name": "Text",
+      "settings": [
+        {
+          "type": "richtext",
+          "id": "text",
+          "label": "Text",
+          "default": "<p>Get easy, fast repairs for accidents like drops and spills, replacement battery service, and 24/7 priority care.</p>"
+        }
+      ]
+    },
+    {
+      "type": "link",

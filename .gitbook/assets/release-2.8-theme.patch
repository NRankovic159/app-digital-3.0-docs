+{% for block in section.blocks %}
+  {% if block.type == 'video_slide' %}
+    {% assign has_video_blocks = true %}
+    {% break %}
+  {% endif %}
+{% endfor %}
+
+{% if has_video_blocks %}
+  <script>
+    document.addEventListener("DOMContentLoaded", function () {
+      let video;
+      let slide;
+      let resizeTimeout;
+      // Hold a reference to the current observer so each resize / re-selection
+      // disconnects the prior one rather than leaking it.
+      let currentObserver = null;
+
+      // Function to select the correct video based on screen width
+      function updateVideoSelection() {
+        if (window.innerWidth <= 767) {
+          video = document.querySelector(".banner-mobile video");
+        } else {
+          video = document.querySelector(".banner-desktop video");
+        }
+
+        if (!video) return;
+
+        slide = video.closest("[aria-hidden]");
+
+        // Ensure that slide is a valid element before proceeding
+        if (!slide) {
+          console.warn("No valid slide found for the video.");
+          return;
+        }
+
+        // Try to autoplay
+        video.play()
+          .then(() => {
+            // Autoplay worked, remove poster to prevent flicker
+            video.removeAttribute("poster");
+          })
+          .catch(() => {
+            // Autoplay blocked, keep the poster
+            video.pause();
+          });
+
+        // Disconnect any previously installed observer before creating a new one,
+        // otherwise resize-triggered re-selection leaks one MutationObserver per call.
+        if (currentObserver) {
+          currentObserver.disconnect();
+          currentObserver = null;
+        }
+
+        // Create an observer to watch for changes to the slide's visibility
+        const observer = new MutationObserver((mutations) => {
+          mutations.forEach((mutation) => {
+            if (
+              mutation.attributeName === "aria-hidden" &&
+              slide.getAttribute("aria-hidden") === "false" && // Now visible
+              mutation.oldValue === "true" // Previously hidden
+            ) {
+              video.currentTime = 0; // Restart only when returning
+              video.play();
+            }
+          });
+        });
+
+        observer.observe(slide, { attributes: true, attributeOldValue: true, attributeFilter: ["aria-hidden"] });
+        currentObserver = observer;
+      }
+
+      // Initial call to select the correct video and set up the observer
+      updateVideoSelection();
+
+      // Listen for window resize and update the video selection accordingly with a delay
+      window.addEventListener("resize", () => {
+        clearTimeout(resizeTimeout); // Clear any previously set timeouts
+        resizeTimeout = setTimeout(() => {
+            updateVideoSelection(); // Re-run the selection and observer setup after resizing stops
+        }, 200); // Delay of 200ms after the user stops resizing
+      });
+    });
+  </script>
+{% endif %}

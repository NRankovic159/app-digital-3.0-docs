diff --git a/theme/sections/service-promo-banner.liquid b/theme/sections/service-promo-banner.liquid
new file mode 100644
index 0000000000000000000000000000000000000000..d8665049104ecc6e7783f8403ffd28e564d52b81
--- /dev/null
+++ b/theme/sections/service-promo-banner.liquid
@@ -0,0 +1,192 @@
+{{ 'section-service-promo-banner.css' | asset_url | stylesheet_tag }}
+
+<div
+  class="service-promo-banner{% if section.settings.background_color == blank or section.settings.background_color == 'rgba(0,0,0,0)' %} service-promo-banner--bordered{% endif %}"
+  {% if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' %}
+    style="background-color: {{ section.settings.background_color }};"
+  {% endif %}
+>
+  <div class="service-promo-banner__container">
+    {%- for block in section.blocks -%}
+      {%- case block.type -%}
+        {%- when 'logo' -%}
+          {%- if block.settings.image != blank -%}
+            <div class="service-promo-banner__logo" {{ block.shopify_attributes }}>
+              {%- assign logo_width = block.settings.logo_width -%}
+              {%- assign logo_width_2x = logo_width | times: 2 -%}
+              <img
+                src="{{ block.settings.image | image_url: width: logo_width_2x }}"
+                srcset="{{ block.settings.image | image_url: width: logo_width }} 1x, {{ block.settings.image | image_url: width: logo_width_2x }} 2x"
+                alt="{{ block.settings.image.alt | escape }}"
+                width="{{ logo_width }}"
+                height="{{ logo_width | divided_by: block.settings.image.aspect_ratio | round }}"
+                loading="lazy"
+              >
+            </div>
+          {%- endif -%}
+
+        {%- when 'heading' -%}
+          <div class="service-promo-banner__heading" {{ block.shopify_attributes }}>
+            {{ block.settings.text }}
+          </div>
+
+        {%- when 'text' -%}
+          <div class="service-promo-banner__text rte" {{ block.shopify_attributes }}>
+            {{ block.settings.text }}
+          </div>
+
+        {%- when 'button' -%}
+          {%- if block.settings.button_label != blank -%}
+            <div class="service-promo-banner__button" {{ block.shopify_attributes }}>
+              <a
+                {% if block.settings.button_link == blank %}
+                  role="link" aria-disabled="true"
+                {% else %}
+                  href="{{ block.settings.button_link }}"
+                {% endif %}
+                class="button button--primary"
+              >
+                {{- block.settings.button_label | escape -}}
+              </a>
+            </div>
+          {%- endif -%}
+
+        {%- when 'image' -%}
+          {%- if block.settings.image != blank -%}
+            {%- assign img_width = block.settings.image_width -%}
+            <div class="service-promo-banner__image" style="max-width: {{ img_width }}px;" {{ block.shopify_attributes }}>
+              {%- assign img_width_2x = img_width | times: 2 -%}
+              {{
+                block.settings.image
+                | image_url: width: img_width_2x
+                | image_tag:
+                  loading: 'lazy',
+                  sizes: '(min-width: 750px) 750px, 100vw',
+                  widths: '375, 550, 750, 1000, 1250, 1500',
+                  alt: block.settings.image.alt
+              }}
+            </div>
+          {%- endif -%}
+      {%- endcase -%}
+    {%- endfor -%}
+  </div>
+</div>
+
+{% schema %}
+{
+  "name": "Service promo banner",
+  "tag": "section",
+  "class": "section",
+  "disabled_on": {
+    "groups": ["header", "footer"]
+  },
+  "settings": [
+    {
+      "type": "color",
+      "id": "background_color",
+      "label": "Background color",
+      "default": "#f5f5f7"
+    }
+  ],
+  "blocks": [
+    {
+      "type": "logo",
+      "name": "Logo",
+      "limit": 1,
+      "settings": [
+        {
+          "type": "image_picker",
+          "id": "image",
+          "label": "Logo image"
+        },
+        {
+          "type": "range",
+          "id": "logo_width",
+          "min": 40,
+          "max": 300,
+          "step": 10,
+          "unit": "px",
+          "label": "Logo width",
+          "default": 100
+        }
+      ]
+    },
+    {
+      "type": "heading",
+      "name": "Heading",
+      "settings": [
+        {
+          "type": "inline_richtext",
+          "id": "text",
+          "label": "Heading text",
+          "default": "Heading"
+        }
+      ]
+    },
+    {
+      "type": "text",
+      "name": "Text",
+      "settings": [
+        {
+          "type": "richtext",
+          "id": "text",
+          "label": "Text content",
+          "default": "<p>Add your text here.</p>"
+        }
+      ]
+    },
+    {
+      "type": "button",
+      "name": "Button",
+      "limit": 1,
+      "settings": [
+        {
+          "type": "text",
+          "id": "button_label",
+          "label": "Button label",
+          "default": "Get coverage"
+        },
+        {
+          "type": "url",
+          "id": "button_link",
+          "label": "Button link"
+        }
+      ]
+    },
+    {
+      "type": "image",
+      "name": "Image",
+      "limit": 1,
+      "settings": [
+        {
+          "type": "image_picker",
+          "id": "image",
+          "label": "Image"
+        },
+        {
+          "type": "range",
+          "id": "image_width",
+          "min": 200,
+          "max": 1200,
+          "step": 10,
+          "unit": "px",
+          "label": "Image width",
+          "default": 500
+        }
+      ]
+    }
+  ],
+  "presets": [
+    {
+      "name": "Service promo banner",
+      "blocks": [
+        { "type": "logo" },
+        { "type": "heading" },
+        { "type": "text" },
+        { "type": "button" },
+        { "type": "image" }
+      ]
+    }
+  ]
+}
+{% endschema %}
